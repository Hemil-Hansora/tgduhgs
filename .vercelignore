# Keep the Vercel upload small — these are never needed at runtime.
# data/, backend/ and frontend sources stay, so the function bundle and
# static build both work.
.git
.venv
.agents
.pytest_cache
**/__pycache__
frontend/node_modules
frontend/dist
bin
.uv-python
*.pyc
# Hide the root Python project files: otherwise Vercel detects a FastAPI
# *app* deployment and serves the backend at every path, ignoring the static
# frontend. The serverless function intentionally uses api/requirements.txt.
pyproject.toml
uv.lock
.python-version
main.py
